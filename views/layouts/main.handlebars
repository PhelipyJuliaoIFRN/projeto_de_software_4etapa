<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>EgoDelivery</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="ego-layout">
    {{!-- Login e cadastro recebem ocultarNavegacao: true. --}}
    {{#unless ocultarNavegacao}}
        <header class="ego-header">
            <div class="ego-header__conteudo">
                <a class="ego-marca" href="/" aria-label="EgoDelivery — início">
                    {{!-- Podemos substituir o emoji pela sua logo depois. --}}
                    <span class="ego-marca__icone" aria-hidden="true">🍔</span>
                    <span>Ego<span class="ego-marca__destaque">Delivery</span></span>
                </a>

                <nav class="ego-menu" aria-label="Navegação principal">
                    <a class="ego-menu__link" href="/cardapio">Cardápio</a>
                    <a class="ego-menu__link" href="/restaurantes">Restaurantes</a>
                    <a class="ego-botao ego-botao--contorno" href="/login">
                        Entrar
                    </a>
                    <a class="ego-botao ego-botao--vermelho" href="/signin">
                        Cadastrar
                    </a>
                </nav>
            </div>
        </header>
    {{/unless}}

    {{!-- Conteúdo da página renderizada pelo Express. --}}
    <main class="ego-conteudo">
        {{{body}}}
    </main>

    {{#unless ocultarNavegacao}}
        <footer class="ego-footer">
            <div class="ego-footer__conteudo">
                <div>
                    <a class="ego-marca" href="/">
                        <span class="ego-marca__icone" aria-hidden="true">🍔</span>
                        <span>Ego<span class="ego-marca__destaque">Delivery</span></span>
                    </a>

                    <p class="ego-footer__descricao">
                        Seu próximo pedido começa aqui.
                    </p>
                </div>

                <nav class="ego-footer__links" aria-label="Links do rodapé">
                    <a href="/cardapio">Cardápio</a>
                    <a href="/restaurantes">Restaurantes</a>
                    <a href="/sobreNos">Sobre nós</a>
                </nav>
            </div>

            <div class="ego-footer__base">
                <small>EgoDelivery · Projeto acadêmico</small>
            </div>
        </footer>
    {{/unless}}
</body>
</html>