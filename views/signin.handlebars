<section class="cadastro" aria-labelledby="cadastro-titulo">
    <a class="cadastro__voltar" href="/">
        <span aria-hidden="true">←</span> Voltar ao início
    </a>

    <div class="cadastro__card">
        <a class="cadastro__marca" href="/" aria-label="EgoDelivery — início">
            <span aria-hidden="true">🍔</span>
            Ego<span class="cadastro__marca-destaque">Delivery</span>
        </a>

        <h1 id="cadastro-titulo">Criar conta</h1>
        <p class="cadastro__introducao">
            Cadastre-se e encontre seu próximo pedido.
        </p>

        {{!-- Mensagem enviada pelo servidor quando o cadastro falhar. --}}
        {{#if erro}}
            <p class="cadastro__erro" role="alert">{{erro}}</p>
        {{/if}}

        {{!-- O Express deverá implementar POST /signin para salvar o cliente. --}}
        <form class="cadastro__form" action="/signin" method="POST">
            <div class="cadastro__campo">
                <label for="nome-completo">Nome completo</label>
                <input
                    type="text"
                    id="nome-completo"
                    name="nome_completo"
                    placeholder="Digite seu nome completo"
                    autocomplete="name"
                    maxlength="150"
                    required
                >
            </div>

            <div class="cadastro__linha">
                <div class="cadastro__campo">
                    <label for="cpf">CPF</label>
                    <input
                        type="text"
                        id="cpf"
                        name="cpf"
                        placeholder="Somente números"
                        inputmode="numeric"
                        pattern="[0-9]{11}"
                        minlength="11"
                        maxlength="11"
                        aria-describedby="cpf-ajuda"
                        required
                    >
                    <small id="cpf-ajuda">Digite os 11 dígitos, sem pontuação.</small>
                </div>

                <div class="cadastro__campo">
                    <label for="data-nascimento">Data de nascimento</label>
                    <input
                        type="date"
                        id="data-nascimento"
                        name="data_de_nascimento"
                        autocomplete="bday"
                        required
                    >
                </div>
            </div>

            <div class="cadastro__campo">
                <label for="email">E-mail</label>
                <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="voce@exemplo.com"
                    autocomplete="email"
                    maxlength="254"
                    required
                >
            </div>

            <div class="cadastro__campo">
                <label for="telefone">Telefone com DDD</label>
                <input
                    type="tel"
                    id="telefone"
                    name="telefone"
                    placeholder="84999999999"
                    autocomplete="tel-national"
                    inputmode="numeric"
                    pattern="[0-9]{10,11}"
                    minlength="10"
                    maxlength="11"
                    aria-describedby="telefone-ajuda"
                    required
                >
                <small id="telefone-ajuda">
                    Digite o DDD e o número, sem espaços ou pontuação.
                </small>
            </div>

            <div class="cadastro__campo">
                <label for="senha">Senha</label>
                <input
                    type="password"
                    id="senha"
                    name="senha"
                    placeholder="Crie sua senha"
                    autocomplete="new-password"
                    minlength="8"
                    maxlength="128"
                    aria-describedby="senha-ajuda"
                    required
                >
                <small id="senha-ajuda">Use pelo menos 8 caracteres.</small>
            </div>

            <div class="cadastro__campo">
                <label for="confirmar-senha">Confirmar senha</label>
                <input
                    type="password"
                    id="confirmar-senha"
                    name="confirmar_senha"
                    placeholder="Digite a senha novamente"
                    autocomplete="new-password"
                    minlength="8"
                    maxlength="128"
                    required
                >
            </div>

            <button class="cadastro__botao" type="submit">
                Criar minha conta
            </button>
        </form>

        <p class="cadastro__login">
            Já tem uma conta? <a href="/login">Entrar</a>
        </p>
    </div>
</section>